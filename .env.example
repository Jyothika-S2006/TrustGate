# Local FastAPI process only. Obtain the key from your ArmorIQ account.
ARMORIQ_API_KEY=replace-with-your-own-key

# Comma-separated allowed browser origins. Set this on the API host too.
FRONTEND_URL=http://localhost:5173

# Frontend build-time URL. On Vercel, set this to the deployed FastAPI base URL.
VITE_API_BASE_URL=http://127.0.0.1:8000
